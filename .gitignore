# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated preview screenshots/video
/preview/*.png
/preview/*.jpg
/preview/*.webm

# Hero films stay out of git entirely — they run to ~100MB each and git keeps
# every version for ever. The live site streams the film from Vercel Blob via
# NEXT_PUBLIC_HERO_VIDEO_URL; `npm run upload:hero` pushes a new cut up there.
# Locally, drop the file at public/videos/intro-hero.mp4 and it is used as the
# fallback with no env var set.
/public/videos/*

# Admin image uploads (dev)
/public/uploads/

# Raw design exports — most are photographs base64-wrapped in SVG (~104 MB), so
# the folder is ignored wholesale. The exceptions below re-include only the files
# actually referenced at runtime by src/content/media.ts (~7.9 MB), so the live
# site's section backdrops and photography deploy to Vercel.
public/images/Design Images svg/*
!public/images/Design Images svg/1.svg
!public/images/Design Images svg/2.svg
!public/images/Design Images svg/3.svg
!public/images/Design Images svg/4.svg
!public/images/Design Images svg/1.avif
!public/images/Design Images svg/2.avif
!public/images/Design Images svg/3.avif
!public/images/Design Images svg/4.avif
!public/images/Design Images svg/5.avif
!public/images/Design Images svg/11.avif
!public/images/Design Images svg/12.avif
!public/images/Design Images svg/13.avif
!public/images/Design Images svg/14.avif
!public/images/Design Images svg/15.avif
!public/images/Design Images svg/16.avif
!public/images/Design Images svg/17.avif
!public/images/Design Images svg/Royal Blue background.png

# Client correction documents — large Word files with embedded screenshots.
*.docx
